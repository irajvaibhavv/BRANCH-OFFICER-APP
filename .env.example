# Copy to .env.local (git-ignored). Without a key, SAARTHI AI falls back to the browser's built-in voice.
# Engine picked automatically: ElevenLabs, then Murf, then browser. Force one with VITE_TTS_ENGINE=elevenlabs|murf|browser
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE=EXAVITQu4vr4xnSDxMaL
VITE_MURF_API_KEY=
VITE_MURF_VOICE=en-IN-arohi
# Speaking pace, 0.7 (slow) – 1.2 (fast). Default 0.85
VITE_TTS_SPEED=0.85

# --- Sarthi AI -------------------------------------------------------------
# The Gemini key NEVER goes here: VITE_* is inlined into the client bundle.
# Local dev:  set GEMINI_API_KEY in the terminal, then `npm run sarthi` (proxy on :3001).
# Vercel:     add GEMINI_API_KEY as a project env var; api/sarthi-*.js serve the same routes.
# Without a reachable proxy, Sarthi runs its scripted demo interview instead.
# VITE_SARTHI_PROXY=http://localhost:3001
#
# Sarthi speaks in its own voice (SAARTHI AI keeps the VITE_MURF_/VITE_ELEVENLABS_ ones above):
# VITE_SARTHI_TTS_ENGINE=murf
# VITE_SARTHI_VOICE=en-IN-aarav
# VITE_SARTHI_VOICE_STYLE=Conversational
# VITE_SARTHI_TTS_SPEED=1
