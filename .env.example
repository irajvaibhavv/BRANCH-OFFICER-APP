# Copy to .env.local (git-ignored). Without a key, SAARTHI AI falls back to the browser's built-in voice.
# Engine picked automatically: ElevenLabs, then Murf, then browser. Force one with VITE_TTS_ENGINE=elevenlabs|murf|browser
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE=EXAVITQu4vr4xnSDxMaL
VITE_MURF_API_KEY=
VITE_MURF_VOICE=en-IN-arohi
# Speaking pace, 0.7 (slow) – 1.2 (fast). Default 0.85
VITE_TTS_SPEED=0.85

# --- Sarthi AI -------------------------------------------------------------
# The Gemini key must NEVER carry a VITE_ prefix: VITE_* is inlined into the client bundle and
# would ship the key to every phone that opens the app. It is read server-side only.
# Local dev:  put GEMINI_API_KEY=... in .env.local (git-ignored), then `npm run sarthi` (proxy
#             on :3001 — the script loads .env.local itself). Never add it to this file.
# Vercel:     add GEMINI_API_KEY as a project env var, then redeploy; api/sarthi-*.js serve the
#             same routes. Env vars only take effect on a new deployment.
# Without a reachable proxy, Sarthi runs its scripted demo interview instead.
# VITE_SARTHI_PROXY=http://localhost:3001
#
# Background video observations. This runs on a clock, so it spends quota on wall time whether or
# not anyone is speaking — it is the biggest consumer of a free Gemini key. Defaults: a frame every
# 45s, at most 12 per interview. Set MS to 0 or "off" to disable vision entirely (the interview and
# the report both work without it). Minimum interval is 15s.
# VITE_SARTHI_VISION_MS=45000
# VITE_SARTHI_VISION_MAX=12
#
# Sarthi speaks in its own voice (SAARTHI AI keeps the VITE_MURF_/VITE_ELEVENLABS_ ones above):
# VITE_SARTHI_TTS_ENGINE=murf
# VITE_SARTHI_VOICE=en-IN-aarav
# VITE_SARTHI_VOICE_STYLE=Conversational
# VITE_SARTHI_TTS_SPEED=1
